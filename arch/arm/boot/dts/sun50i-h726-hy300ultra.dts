		};

		mdio@4500048 {
			compatible = "allwinner,sunxi-mdio";
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			reg = <0x00 0x4500048 0x00 0x08>;
			status = "okay";
			phandle = <0xbe>;

			ethernet-phy@10 {
				compatible = "ethernet-phy-idc000.0000";
				reg = <0x10>;
				phandle = <0xbf>;
			};

			ethernet-phy@1 {
				compatible = "ethernet-phy-ieee802.3-c22";
				reg = <0x01>;
				max-speed = <0x3e8>;
				reset-assert-us = <0x2710>;
				reset-deassert-us = <0x249f0>;
				phandle = <0x6a>;
			};
		};

		gmac@4500000 {
			compatible = "allwinner,sunxi-gmac";
			reg = <0x00 0x4500000 0x00 0x10000 0x00 0x3000030 0x00 0x04>;
			interrupts = <0x00 0x10 0x04>;
			interrupt-names = "gmacirq";
			clocks = <&ccu 0x67 &ccu 0x66 &ccu 0x33>;
			clock-names = "gmac", "phy25m", "hbus";
			assigned-clocks = <0x13 0x66>;
			assigned-clock-rates = <0x17d7840>;
			resets = <&ccu 0x1d>;
			phy-handle = <0x6a>;
			status = "disabled";
			phandle = <0xc0>;
		};

		timestamp@8220000 {
			compatible = "allwinner,timestamp";
