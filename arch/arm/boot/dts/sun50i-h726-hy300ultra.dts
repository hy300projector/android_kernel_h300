	soc@3000000 {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x78>;

		rtc_ccu: rtc_ccu@7090000 {
			compatible = "allwinner,sun50iw15-rtc-ccu";
			reg = <0x00 0x7090000 0x00 0x328>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x16>;
		};

		cpupll_ccu: cpupll_ccu@2001000 {
			compatible = "allwinner,sun50iw15-cpupll";
			reg = <0x00 0x2001000 0x00 0x04 0x00 0x2001080 0x00 0x04 0x00 0x2001200 0x00 0x04 0x00 0x2001404 0x00 0x04>;
			reg-names = "pll_cpu_base", "pll_cpu", "pll_cpu_pat0", "pll_cpu_ssc";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			pll_step = <0x09>;
			pll_ssc = <0x3300>;
			phandle = <0x03>;
		};

		ccu: ccu@2002000 {
			compatible = "allwinner,sun50iw15-ccu";
			reg = <0x00 0x2001000 0x00 0x2000>;
			clocks = <&dcxo24M_clk &rtc_ccu 0x03 &rc16m_clk>;
			clock-names = "hosc", "losc", "iosc";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x13>;
		};

		r_ccu: r_ccu@7010000 {
			compatible = "allwinner,sun50iw15-r-ccu";
			reg = <0x00 0x7010000 0x00 0x250>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x14>;
		};

		drampll_ccu: drampll_ccu@4830000 {
			compatible = "allwinner,sun50iw15-pll-dram";
			reg = <0x00 0x4830000 0x00 0x1000>;
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			phandle = <0x19>;
		};

		pd_ve_test@0 {
			compatible = "allwinner,sunxi-power-domain-test";
			power-domains = <&power_controller 0x01>;
			status = "okay";
			phandle = <0x79>;
		};

		nsi-controller@2020000 {
			compatible = "allwinner,sun50i-nsi";
			interrupts = <0x00 0x44 0x04>;
			reg = <0x00 0x2020000 0x00 0x10000>;
			clocks = <&drampll_ccu 0x04 &ccu 0x29 &ccu 0x22 &ccu 0x2a &ccu 0x25 &ccu 0x04>;
			clock-names = "bus-p", "bus", "nsi-p", "nsi", "ahb", "pll";
			clock-frequency = <0x23c34600 0x29b92700>;
			resets = <&ccu 0x01>;
			reset-names = "bus_nsi";
			#nsi-cells = <0x01>;
			clk_path_type = <0x01>;
			topology_type = <0x02>;
			channel_type = <0x01>;
			master_clks = <0x00 0x00 0x01 0x03 0x02 0x03 0x03 0x03 0x04 0x03 0x05 0x03 0x06 0x03 0x07 0x03 0x08 0x03 0x09 0x03 0x0a 0x03 0x0b 0x03 0x0c 0x03 0x0d 0x03 0x0e 0x03 0x0f 0x03 0x10 0x03 0x11 0x03 0x12 0x03 0x13 0x03 0x14 0x03 0x17 0x00>;
			ia_pmu_data_unit = <0x40>;
			ta_pmu_data_unit = <0x40>;
			ra_pmu_data_unit = <0x40>;
			cpu_pmu_data_unit = <0x40>;
			sub_node_id_mapping;
			phandle = <0x7a>;

			cpu {
				id = <0x00>;
				mode = <0x00>;
				pri = <0x00>;
				select = <0x01>;
			};

			gpu {
				id = <0x01>;
				mode = <0x00>;
				pri = <0x00>;
				select = <0x01>;
			};

			ve_r {
				id = <0x02>;
				mode = <0x00>;
				pri = <0x02>;
				select = <0x01>;
			};

			ve {
				id = <0x03>;
				mode = <0x00>;
				pri = <0x02>;
				select = <0x01>;
			};

			tvd_ksc {
				id = <0x05>;
				mode = <0x00>;
				pri = <0x03>;
				select = <0x01>;
			};

			tvd_dec {
				id = <0x06>;
				mode = <0x00>;
				pri = <0x03>;
				select = <0x01>;
			};

			tvdisp {
				id = <0x07>;
				mode = <0x00>;
				pri = <0x03>;
				select = <0x01>;
			};

			tvcap {
				id = <0x08>;
				mode = <0x00>;
				pri = <0x03>;
				select = <0x01>;
			};

			iommu {
				id = <0x09>;
				mode = <0x00>;
				pri = <0x03>;
				select = <0x01>;
			};
		};

		ve@1c0e000 {
			compatible = "allwinner,sunxi-cedar-ve";
