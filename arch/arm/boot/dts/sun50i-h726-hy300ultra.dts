			dmas = <&dma_controller 0x02 &dma_controller 0x02>;
			dma-names = "tx", "rx";
			playback-cma = <0x80>;
			capture-cma = <0x80>;
			tx-fifo-size = <0x80>;
			rx-fifo-size = <0x80>;
			status = "okay";
			tdm-num = <0x00>;
