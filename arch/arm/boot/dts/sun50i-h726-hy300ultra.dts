/dts-v1/;

/ {
	model = "sun50iw15";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	board = "H726", "H726-P1";
	compatible = "allwinner,h726", "arm,sun50iw15p1";

	vf_mapping_table {
		vf-version = "V0.7";
		table = <0x00 0x00 0x01 0x100 0x02 0x200 0x03 0x300 0x04 0x400 0x11 0x101 0x13 0x301>;
		phandle = <0x6c>;
	};

	cluster-opp-table {
		compatible = "allwinner,sun50i-operating-points";
		opp-shared;
		phandle = <0x04>;

		opp@480000000 {
			opp-hz = <0x00 0x1c9c3800>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0xdbba0>;
			opp-microvolt-vf0100 = <0xdbba0>;
			opp-microvolt-vf0200 = <0xdbba0>;
			opp-microvolt-vf0300 = <0xe09c0>;
			opp-microvolt-vf0400 = <0xdbba0>;
			opp-microvolt-vf0101 = <0xe09c0>;
			opp-microvolt-vf0301 = <0xdbba0>;
		};

		opp@720000000 {
			opp-hz = <0x00 0x2aea5400>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0xdbba0>;
			opp-microvolt-vf0100 = <0xdbba0>;
			opp-microvolt-vf0200 = <0xdbba0>;
			opp-microvolt-vf0300 = <0xe09c0>;
			opp-microvolt-vf0400 = <0xdbba0>;
			opp-microvolt-vf0101 = <0xe09c0>;
			opp-microvolt-vf0301 = <0xdbba0>;
		};

		opp@1128000000 {
			opp-hz = <0x00 0x433bea00>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0xdbba0>;
			opp-microvolt-vf0100 = <0xdbba0>;
			opp-microvolt-vf0200 = <0xdbba0>;
			opp-microvolt-vf0300 = <0xef420>;
			opp-microvolt-vf0400 = <0xdbba0>;
			opp-microvolt-vf0101 = <0xe09c0>;
			opp-microvolt-vf0301 = <0xdbba0>;
		};

		opp@1200000000 {
			opp-hz = <0x00 0x47868c00>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-vf0100 = <0xdbba0>;
			opp-microvolt-vf0200 = <0xdbba0>;
			opp-microvolt-vf0300 = <0xf9060>;
			opp-microvolt-vf0400 = <0xe09c0>;
			opp-microvolt-vf0101 = <0xe09c0>;
			opp-microvolt-vf0301 = <0xdbba0>;
		};

		opp@1248000000 {
			opp-hz = <0x00 0x4a62f800>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0xe7ef0>;
			opp-microvolt-vf0100 = <0x00>;
			opp-microvolt-vf0200 = <0x00>;
			opp-microvolt-vf0300 = <0x00>;
			opp-microvolt-vf0400 = <0x00>;
			opp-microvolt-vf0101 = <0x00>;
			opp-microvolt-vf0301 = <0x00>;
		};

		opp@1272000000 {
			opp-hz = <0x00 0x4bd12e00>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-vf0100 = <0xe09c0>;
			opp-microvolt-vf0200 = <0xe09c0>;
			opp-microvolt-vf0300 = <0x100590>;
			opp-microvolt-vf0400 = <0xe57e0>;
			opp-microvolt-vf0101 = <0xe7ef0>;
			opp-microvolt-vf0301 = <0xdbba0>;
		};

		opp@1392000000 {
			opp-hz = <0x00 0x52f83c00>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0xf4240>;
			opp-microvolt-vf0100 = <0xea600>;
			opp-microvolt-vf0200 = <0xef420>;
			opp-microvolt-vf0300 = <0x10c8e0>;
			opp-microvolt-vf0400 = <0xf4240>;
			opp-microvolt-vf0101 = <0xf4240>;
			opp-microvolt-vf0301 = <0xe57e0>;
		};

		opp@1512000000 {
			opp-hz = <0x00 0x5a1f4a00>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-vf0100 = <0xf4240>;
			opp-microvolt-vf0200 = <0xfde80>;
			opp-microvolt-vf0300 = <0x00>;
			opp-microvolt-vf0400 = <0x102ca0>;
			opp-microvolt-vf0101 = <0x00>;
			opp-microvolt-vf0301 = <0x00>;
		};

		opp@1608000000 {
			opp-hz = <0x00 0x5fd82200>;
			clock-latency-ns = <0x3b9b0>;
			opp-microvolt-vf0000 = <0x00>;
			opp-microvolt-vf0100 = <0x00>;
			opp-microvolt-vf0200 = <0x10c8e0>;
			opp-microvolt-vf0300 = <0x00>;
			opp-microvolt-vf0400 = <0x111700>;
			opp-microvolt-vf0101 = <0x00>;
			opp-microvolt-vf0301 = <0x00>;
		};
	};

	ve-opp-table {
		compatible = "allwinner,ve-operating-points";
		phandle = <0x1a>;

		opp-vf0000 {
			opp-hz-0 = <0x00 0x22551000>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0100 {
			opp-hz-0 = <0x00 0x22551000>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0200 {
			opp-hz-0 = <0x00 0x22551000>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0300 {
			opp-hz-0 = <0x00 0x1c9c3800>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0400 {
			opp-hz-0 = <0x00 0x22551000>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0101 {
			opp-hz-0 = <0x00 0x1c9c3800>;
			opp-microvolt-0 = <0xea600>;
		};

		opp-vf0301 {
			opp-hz-0 = <0x00 0x1c9c3800>;
			opp-microvolt-0 = <0xea600>;
		};
	};

	aliases {
		serial0 = "/soc@3000000/uart@2600000";
		serial1 = "/soc@3000000/uart@2600400";
		serial2 = "/soc@3000000/uart@2600800";
		serial3 = "/soc@3000000/uart@2600c00";
		serial4 = "/soc@3000000/uart@7080000";
		sunxi-mmc0 = "/soc@3000000/sdmmc@4020000";
		sunxi-mmc2 = "/soc@3000000/sdmmc@4022000";
		twi0 = "/soc@3000000/twi0@2502000";
		twi1 = "/soc@3000000/twi1@2502400";
		twi2 = "/soc@3000000/twi2@2502800";
		twi3 = "/soc@3000000/twi3@2502C00";
		twi4 = "/soc@3000000/twi4@2503000";
		twi5 = "/soc@3000000/twi@7081400";
		twi6 = "/soc@3000000/twi@7081800";
		pwm0 = "/soc@3000000/pwm0@2000c00";
		pwm1 = "/soc@3000000/s_pwm0@7020c00";
		gpadc0 = "/soc@3000000/gpadc0@7070000";
		ir0 = "/soc@3000000/s_ir_rx@7040000";
		spi0 = "/soc@3000000/spi0@4025000";
		spi1 = "/soc@3000000/spi@4026000";
		spi2 = "/soc@3000000/spi@4027000";
		ve0 = "/soc@3000000/ve@1c0e000";
		pmu0 = "/soc@3000000/twi@7081400/pmu@36";
		arisc-config = "/arisc_config";
		standby_param = "/standby_param";
		box-start-os0 = "/box_start_os0";
		cir_param = "/cir_param";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		bl31 {
			reg = <0x00 0x48000000 0x00 0x100000>;
		};

		drm_heap_reserved: drm-heap@58000000 {
			reg = <0x00 0x58000000 0x00 0x02000000>;
			no-map;
		};

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x00 0x10000000>;
			alignment = <0x00 0x2000>;
			linux,cma-default;
		};
	};

	drm_heap: drm-heap {
		compatible = "allwinner,sunxi-drm-heap";
		memory-region = <&drm_heap_reserved>;
		status = "okay";
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x00 0x40000000 0x00 0x20000000>;
	};

	firmware {

		android {
			compatible = "android,firmware";
			boot_devices = "soc@3000000/4020000.sdmmc,soc@3000000/4022000.sdmmc,soc@3000000";

			vbmeta {
				compatible = "android,vbmeta";
				parts = "vbmeta,vbmeta_system,vbmeta_vendor,boot,init_boot";
			};
		};

		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
		};
	};

	cpu_idle_ths: cpu_idle_ths {
		compatible = "allwinner,sunxi-max-temp-ths";
		ext-ths-rely = <0x02>;
		#thermal-sensor-cells = <0x00>;
		status = "okay";
		phandle = <0x0e>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x00>;
			enable-method = "psci";
			clocks = <&cpupll_ccu 0x00>;
			operating-points-v2 = <0x04>;
			cpu-idle-states = <0x05>;
			#cooling-cells = <0x02>;
			dynamic-power-coefficient = <0xf6>;
			cpu-supply = <0x06>;
			phandle = <0x09>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x01>;
			enable-method = "psci";
			clocks = <&cpupll_ccu 0x00>;
			operating-points-v2 = <0x04>;
			cpu-idle-states = <0x05>;
			#cooling-cells = <0x02>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x02>;
			enable-method = "psci";
			clocks = <&cpupll_ccu 0x00>;
			operating-points-v2 = <0x04>;
			cpu-idle-states = <0x05>;
			#cooling-cells = <0x02>;

			thermal_idle: thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0x1f4>;
				phandle = <0x10>;
			};
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a53", "arm,armv8";
			reg = <0x00 0x03>;
			enable-method = "psci";
			clocks = <&cpupll_ccu 0x00>;
			operating-points-v2 = <0x04>;
			cpu-idle-states = <0x05>;
			#cooling-cells = <0x02>;

			thermal_idle_node: thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0x1f4>;
				phandle = <0x11>;
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cluster-sleep {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010000>;
				entry-latency-us = <0x2f>;
				exit-latency-us = <0x4a>;
				min-residency-us = <0x1388>;
				local-timer-stop;
				phandle = <0x05>;
			};
		};
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	thermal-zones {

		cpu_thermal_zone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&ths 0x00>;
			sustainable-power = <0x55a>;
			phandle = <0x02>;

			trips {
				phandle = <0x6d>;

				trip-point@0 {
					temperature = <0x13880>;
					type = "passive";
					hysteresis = <0x7d0>;
					phandle = <0x6e>;
				};

				trip-point@1 {
					temperature = <0x19a28>;
					type = "passive";
					hysteresis = <0x7d0>;
					phandle = <0x08>;
				};

				cpu_crit@0 {
					temperature = <0x1c138>;
					type = "critical";
					hysteresis = <0x00>;
					phandle = <0x6f>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x08>;
					cooling-device = <&cpu 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		gpu_thermal_zone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&ths 0x01>;
			sustainable-power = <0x960>;
			phandle = <0x70>;

			trips {
				phandle = <0x71>;

				gpu_point@0 {
					temperature = <0x11170>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x0a>;
				};

				gpu_point@1 {
					temperature = <0x15f90>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x0c>;
				};

				gpu_crit@0 {
					temperature = <0x1c138>;
					type = "critical";
					hysteresis = <0x00>;
					phandle = <0x0d>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0a>;
					cooling-device = <&gpu 0x00 0x00>;
					contribution = <0x400>;
				};

				map1 {
					trip = <0x0c>;
					cooling-device = <&gpu 0x00 0xffffffff>;
					contribution = <0x400>;
				};

				map2 {
					trip = <0x0d>;
					cooling-device = <&gpu 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		cpu_idle_zone {
			polling-delay-passive = <0x64>;
			polling-delay = <0x3e8>;
			thermal-sensors = <&cpu_idle_ths>;
			phandle = <0x72>;

			trips {
				phandle = <0x73>;

				trip-point@0 {
					temperature = <0x13880>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x74>;
				};

				trip-point@1 {
					temperature = <0x15f90>;
					type = "passive";
					hysteresis = <0x00>;
					phandle = <0x0f>;
				};
			};

			cooling-maps {

				map0 {
					trip = <0x0f>;
					cooling-device = <&thermal_idle 0x00 0x64 &thermal_idle_node 0x00 0x64>;
					contribution = <0x400>;
				};
			};
		};
	};

	dcxo24M_clk: dcxo24M_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x16e3600>;
		clock-output-names = "dcxo24M";
		phandle = <0x15>;
	};

	rc16m_clk: rc16m_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0xf42400>;
		clock-accuracy = <0x11e1a300>;
		clock-output-names = "rc-16m";
		phandle = <0x17>;
	};

	ext32k_clk {
		#clock-cells = <0x00>;
		compatible = "fixed-clock";
		clock-frequency = <0x8000>;
		clock-output-names = "ext-32k";
		phandle = <0x75>;
	};

	interrupt-controller@3400000 {
		compatible = "arm,gic-400";
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		device_type = "gic";
		interrupt-controller;
		reg = <0x00 0x3401000 0x00 0x1000 0x00 0x3402000 0x00 0x2000 0x00 0x3404000 0x00 0x2000 0x00 0x3406000 0x00 0x2000>;
		interrupts = <0x01 0x09 0xf04>;
		interrupt-parent = <0x12>;
		phandle = <0x12>;
	};

	interrupt-controller@0 {
		compatible = "allwinner,sunxi-wakeupgen";
		interrupt-controller;
		#interrupt-cells = <0x03>;
		#address-cells = <0x00>;
		interrupt-parent = <0x12>;
		phandle = <0x01>;
	};

	timer_arch {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0xf08 0x01 0x0e 0xf08 0x01 0x0b 0xf08 0x01 0x0a 0xf08>;
		clock-frequency = <0x16e3600>;
		interrupt-parent = <0x12>;
		arm,no-tick-in-suspend;
	};

	intc-nmi@7010320 {
		compatible = "allwinner,sun8i-nmi";
		interrupt-parent = <0x12>;
		#interrupt-cells = <0x02>;
		#address-cells = <0x00>;
		interrupt-controller;
		reg = <0x00 0x7010320 0x00 0x0c>;
		interrupts = <0x00 0x8c 0x04>;
		phandle = <0x3c>;
	};

	iommu: iommu@2010000 {
		compatible = "allwinner,iommu-v14-sun50iw15";
		reg = <0x00 0x2010000 0x00 0x1000>;
		interrupts = <0x00 0x47 0x04>;
		interrupt-names = "iommu-irq";
		clocks = <&ccu 0x4b>;
		clock-names = "iommu";
		#iommu-cells = <0x02>;
		phandle = <0x1b>;
	};

	pck-600@7060000 {
		compatible = "allwinner,sun50iw15-pck", "syscon", "simple-mfd";
		reg = <0x00 0x7060000 0x00 0x2000>;
		phandle = <0x76>;

		power_controller: power-controller {
			compatible = "allwinner,sun50iw15-pck-600";
			clocks = <&r_ccu 0x10>;
			clock-names = "pck";
			resets = <&r_ccu 0x07>;
			reset-names = "pck_rst";
			#power-domain-cells = <0x01>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0x18>;

			pd_gpu@0 {
				reg = <0x00>;
			};

			pd_ve@1 {
				reg = <0x01>;
			};
		};
	};

	dram {
		dram_para00 = <0x00>;
		dram_para01 = <0x00>;
		dram_para02 = <0x00>;
		dram_para03 = <0x00>;
		dram_para04 = <0x00>;
		dram_para05 = <0x00>;
		dram_para06 = <0x00>;
		dram_para07 = <0x00>;
		dram_para08 = <0x00>;
		dram_para09 = <0x00>;
		dram_para10 = <0x00>;
		dram_para11 = <0x00>;
		dram_para12 = <0x00>;
		dram_para13 = <0x00>;
		dram_para14 = <0x00>;
		dram_para15 = <0x00>;
		dram_para16 = <0x00>;
		dram_para17 = <0x00>;
		dram_para18 = <0x00>;
		dram_para19 = <0x00>;
		dram_para20 = <0x00>;
		dram_para21 = <0x00>;
		dram_para22 = <0x00>;
		dram_para23 = <0x00>;
		dram_para24 = <0x00>;
		dram_para25 = <0x00>;
		dram_para26 = <0x00>;
		dram_para27 = <0x00>;
		dram_para28 = <0x00>;
		dram_para29 = <0x00>;
		dram_para30 = <0x00>;
		dram_para31 = <0x00>;
		dram_para32 = <0x00>;
		dram_para33 = <0x00>;
		dram_para34 = <0x00>;
		dram_para35 = <0x00>;
		dram_para36 = <0x00>;
		dram_para37 = <0x00>;
		dram_para38 = <0x00>;
		dram_para39 = <0x00>;
		dram_para40 = <0x00>;
		dram_para41 = <0x00>;
		dram_para42 = <0x00>;
		dram_para43 = <0x00>;
		dram_para44 = <0x00>;
		dram_para45 = <0x00>;
		dram_para46 = <0x00>;
		dram_para47 = <0x00>;
		dram_para48 = <0x00>;
		dram_para49 = <0x00>;
		dram_para50 = <0x00>;
		dram_para51 = <0x00>;
		dram_para52 = <0x00>;
		dram_para53 = <0x00>;
		dram_para54 = <0x00>;
		dram_para55 = <0x00>;
		dram_para56 = <0x00>;
		dram_para57 = <0x00>;
		dram_para58 = <0x00>;
		dram_para59 = <0x00>;
		dram_para60 = <0x00>;
		dram_para61 = <0x00>;
		dram_para62 = <0x00>;
		dram_para63 = <0x00>;
		dram_para64 = <0x00>;
		dram_para65 = <0x00>;
		dram_para66 = <0x00>;
		dram_para67 = <0x00>;
		dram_para68 = <0x00>;
		dram_para69 = <0x00>;
		dram_para70 = <0x00>;
		dram_para71 = <0x00>;
		dram_para72 = <0x00>;
		dram_para73 = <0x00>;
		dram_para74 = <0x00>;
		dram_para75 = <0x00>;
		dram_para76 = <0x00>;
		dram_para77 = <0x00>;
		dram_para78 = <0x00>;
		dram_para79 = <0x00>;
		dram_para80 = <0x00>;
		dram_para81 = <0x00>;
		dram_para82 = <0x00>;
		dram_para83 = <0x00>;
		dram_para84 = <0x00>;
