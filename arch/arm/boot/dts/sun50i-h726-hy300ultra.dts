			reg = <0x00 0x2033000 0x00 0x7c>;
			resets = <&ccu 0x1e>;
			clocks = <&ccu 0x69 &ccu 0x23 &ccu 0x07 &ccu 0x68>;
			clock-names = "clk_bus_i2s", "clk_pll_audio_4x", "clk_pll_peri0_200m", "clk_i2s";
			dmas = <&dma_controller 0x03 &dma_controller 0x03>;
			dma-names = "tx", "rx";
			playback-cma = <0x80>;
			capture-cma = <0x80>;
			tx-fifo-size = <0x80>;
			rx-fifo-size = <0x80>;
			status = "okay";
			tdm-num = <0x00>;
			tx-pin = <0x00>;
			rx-pin = <0x00>;
			tx-hub-en;
			rx-sync-en;
			phandle = <0x69>;
		};

		i2s_mach {
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name = "sndi2s";
			soundcard-mach,format = "i2s";
			soundcard-mach,slot-num = <0x02>;
			soundcard-mach,slot-width = <0x20>;
			status = "okay";
			soundcard-mach,frame-master = <0x68>;
			soundcard-mach,bitclock-master = <0x68>;
			phandle = <0xba>;

