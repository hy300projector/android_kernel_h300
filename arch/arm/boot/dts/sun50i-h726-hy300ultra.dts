			reg = <0x00 0x2034000 0x00 0x58>;
			interrupts = <0x00 0x17 0x04>;
			resets = <&ccu 0x20>;
			clocks = <&ccu 0x6b &ccu 0x23 &ccu 0x06 &ccu 0x05 &ccu 0x6d &ccu 0x6c>;
