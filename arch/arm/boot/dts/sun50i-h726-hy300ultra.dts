			type_addr_bt = <0x00>;
			type_addr_eth = <0x00>;
			phandle = <0xc3>;
		};

		btlpm {
			compatible = "allwinner,sunxi-btlpm";
			status = "okay";
			uart_index = <0x01>;
			bt_wake = <0x62 0x01 0x02 0x00>;
			bt_hostwake = <0x62 0x01 0x03 0x00>;
			wakeup-source;
			phandle = <0xc4>;
		};
	};

	gpu: gpu@0x01800000 {
		device_type = "gpu";
		compatible = "arm,mali-midgard";
		reg = <0x00 0x1800000 0x00 0x10000>;
		interrupts = <0x00 0x75 0x04 0x00 0x76 0x04 0x00 0x4c 0x04>;
		interrupt-names = "JOB", "MMU", "GPU";
		/* kbase takes clocks positionally: index 0 is clk_mali, 1 is the
		 * bus clock it keeps enabled.  The stock list put clk_parent first,
		 * which left the core clock never set. */
		clocks = <&ccu 0x3a &ccu 0x3b>;
		clock-names = "clk_mali", "clk_bus";
		resets = <&ccu 0x03>;
		#cooling-cells = <0x02>;
		power-domains = <&power_controller 0x00>;
		gpu_idle = <0x01>;
		dvfs_status = <0x01>;
		operating-points = <0x927c0 0xdbba0 0x61a80 0xdbba0 0x493e0 0xdbba0 0x30d40 0xdbba0>;
		phandle = <0x0b>;
	};

	vs-osd {
		compatible = "vs,osd";
		status = "okay";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		fastosd_mode = <0x01>;
		reg = <0x00 0x5600000 0x00 0x1000 0x00 0x5000000 0x00 0x340000 0x00 0x5800000 0x00 0x100000>;
		reg-names = "afbd", "svp", "panel";
		interrupt-parent = <0x12>;
		interrupts = <0x00 0x65 0x01 0x00 0x70 0x01>;
		clocks = <&ccu 0x92 &ccu 0x8f &ccu 0x94>;
		clock-names = "disp_afbd", "disp_svp_dtl", "disp_detn_pclk";
		disptop = <0x48>;
		iommus = <&iommu 0x02 0x00>;
		assigned-clocks = <0x13 0x8f 0x13 0x92>;
		assigned-clock-parents = <0x13 0x01 0x13 0x02>;
		assigned-clock-rates = <0xbebc200 0x17d78400>;
		phandle = <0xc5>;
	};

