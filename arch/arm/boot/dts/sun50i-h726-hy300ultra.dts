			hpout-gain = <0x07>;
			lineinl-gain = <0x01>;
			lineinr-gain = <0x01>;
			pa-pin-max = <0x01>;
			pa-pin-0 = <0x62 0x00 0x02 0x00>;
			pa-pin-level-0 = <0x01>;
			pa-pin-msleep-0 = <0x00>;
			pa-pin-msleep1-0 = <0x96>;
			hp-det-gpio = <&pinctrl 0x07 0x11 0x00>;
			jack-det-level = <0x01>;
			tx-pin = <0x00>;
			rx-pin = <0x00>;
			rxfifo-pinmap = <0x00 0x00>;
			rxfifo-chmap = <0x00 0x01>;
			ramp-time-up = <0x03>;
			ramp-time-down = <0x03>;
			dac-src = "I2S";
			adc-dst = "I2S";
			phandle = <0x65>;
		};

		codec_plat: codec_plat {
			#sound-dai-cells = <0x00>;
			compatible = "allwinner,sunxi-snd-plat-aaudio";
			dac-txdata = <0x2030020>;
			adc-txdata = <0x2030040>;
			dmas = <&dma_controller 0x07 &dma_controller 0x07>;
			dma-names = "tx", "rx";
			playback-cma = <0x80>;
			capture-cma = <0x80>;
			tx-fifo-size = <0x80>;
			rx-fifo-size = <0x80>;
			status = "okay";
			phandle = <0x64>;
		};

		codec_mach {
			compatible = "allwinner,sunxi-snd-mach";
			soundcard-mach,name = "audiocodec";
			soundcard-mach,pin-switches = "LINEINL", "LINEINR", "LINEOUTL", "LINEOUTR", "HPOUT", "SPK";
			soundcard-mach,routing = "LINEINL1_PIN", "LINEINL", "LINEINL2_PIN", "LINEINL", "LINEINR1_PIN", "LINEINR", "LINEINR2_PIN", "LINEINR", "LINEOUTL", "LINEOUTLP_PIN", "LINEOUTL", "LINEOUTLN_PIN", "LINEOUTR", "LINEOUTRP_PIN", "LINEOUTR", "LINEOUTRN_PIN", "SPK", "LINEOUTLP_PIN", "SPK", "LINEOUTLN_PIN", "SPK", "LINEOUTRP_PIN", "SPK", "LINEOUTRN_PIN", "HPOUT", "HPOUTL_PIN", "HPOUT", "HPOUTR_PIN";
			soundcard-mach,jack-support = <0x03>;
			status = "okay";
			soundcard-mach,format = "left_j";
			soundcard-mach,frame-master = <0x63>;
			soundcard-mach,bitclock-master = <0x63>;
			soundcard-mach,slot-num = <0x02>;
			soundcard-mach,slot-width = <0x20>;
			phandle = <0xb5>;

			soundcard-mach,cpu {
				sound-dai = <&codec_plat>;
				phandle = <0xb6>;
			};

			soundcard-mach,codec {
				sound-dai = <&codec>;
				soundcard-mach,pll-fs = <0x01>;
				phandle = <0x63>;
			};
		};

		audbrg@203042c {
			compatible = "vs,trid-audio-bridge";
			reg = <0x0 0x6400000 0x0 0x7000>;
			interrupts = <0x00 0x73 0x04 0x00 0x71 0x04>;
			iommus = <&iommu 0x06 0x01>;
			status = "okay";
			phandle = <0xb7>;
		};

		owa_plat: owa_plat@2034000 {
			#sound-dai-cells = <0x00>;
