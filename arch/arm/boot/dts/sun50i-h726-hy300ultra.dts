	gpio_keys {
		compatible = "gpio-keys";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";

		key-power {
			label = "powerkey";
			gpios = <&pinctrl_7022000 0x00 0x04 0x01>;
			linux,input-type = <0x01>;
			linux,code = <0x74>;
			wakeup-source;
		};
	};

