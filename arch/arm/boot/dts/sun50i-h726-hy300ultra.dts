				sound-dai = <&i2s_plat>;
				soundcard-mach,pll-fs = <0x01>;
				soundcard-mach,mclk-fs = <0x01>;
				soundcard-mach,mclk-fp = <0xac4400 0xbb8000>;
				phandle = <0x68>;
			};

			soundcard-mach,codec {
				sound-dai = <&codec>;
				phandle = <0xbb>;
			};
		};

		gpadc0@7070000 {
			compatible = "allwinner,sunxi-gpadc-v101";
			reg = <0x00 0x7070000 0x00 0x400>;
			interrupts = <0x00 0xa1 0x04>;
			clocks = <&r_ccu 0x16 &r_ccu 0x15>;
			clock-names = "bus", "hosc";
			resets = <&r_ccu 0x09>;
			#io-channel-cells = <0x01>;
			status = "disabled";
			channel_num = <0x05>;
			channel_select = <0x18>;
			channel_data_select = <0x18>;
			channel_compare_select = <0x01>;
			channel_cld_select = <0x03>;
			channel_chd_select = <0x00>;
			channel0_compare_lowdata = <0x124f80>;
			channel0_compare_higdata = <0x00>;
			phandle = <0xbc>;
		};

		gpio_leds {
			compatible = "allwinner,sunxi-gpio-leds";
