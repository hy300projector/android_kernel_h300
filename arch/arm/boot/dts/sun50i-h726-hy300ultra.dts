				};

				regulators {
					compatible = "x-powers,axp1530-regulator";

					dcdc1 {
						regulator-name = "axp1530-dcdc1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x33e140>;
						regulator-step-delay-us = <0x19>;
						regulator-final-delay-us = <0x32>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x3d>;
					};

					dcdc2 {
						regulator-name = "axp1530-dcdc2";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x177fa0>;
						regulator-step-delay-us = <0x19>;
						regulator-final-delay-us = <0x32>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x06>;
					};

					dcdc3 {
						regulator-name = "axp1530-dcdc3";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x1c1380>;
						regulator-step-delay-us = <0x19>;
						regulator-final-delay-us = <0x32>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x1c>;
					};

					ldo1 {
						regulator-name = "axp1530-aldo1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-step-delay-us = <0x19>;
						regulator-final-delay-us = <0x32>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x3e>;
					};

					ldo2 {
						regulator-name = "axp1530-dldo1";
						regulator-min-microvolt = <0x7a120>;
						regulator-max-microvolt = <0x3567e0>;
						regulator-step-delay-us = <0x19>;
						regulator-final-delay-us = <0x32>;
						regulator-enable-ramp-delay = <0x3e8>;
						regulator-always-on;
						phandle = <0x3f>;
					};
				};

				virtual-axp1530-dcdc1 {
					compatible = "xpower-vregulator,dcdc1";
					dcdc1-supply = <0x3d>;
				};

				virtual-axp1530-dcdc2 {
					compatible = "xpower-vregulator,dcdc2";
					dcdc2-supply = <0x06>;
				};

				virtual-axp1530-dcdc3 {
					compatible = "xpower-vregulator,dcdc3";
					dcdc3-supply = <0x1c>;
				};

				virtual-axp1530-aldo1 {
					compatible = "xpower-vregulator,aldo1";
