			clocks = <&dcxo24M_clk>;
			clock-names = "hosc";
			status = "okay";
			phandle = <0xc1>;
		};

		rfkill {
			compatible = "allwinner,sunxi-rfkill";
			status = "okay";
			chip_en;
			power_en;
			pinctrl-0;
			pinctrl-names;
			phandle = <0xc2>;

			wlan {
				compatible = "allwinner,sunxi-wlan";
				clocks;
				clock-names;
				wlan_power;
				wlan_power_vol;
				wlan_busnum = <0x01>;
				wlan_regon = <0x62 0x01 0x01 0x00>;
				wlan_hostwake = <0x62 0x01 0x00 0x00>;
				wakeup-source;
			};

			bt {
				compatible = "allwinner,sunxi-bt";
				clocks;
				clock-names;
				bt_power;
				bt_power_vol;
				bt_rst_n = <0x62 0x01 0x04 0x01>;
